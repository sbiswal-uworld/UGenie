# Anthropic / Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Figma personal access token
# Get it at: https://www.figma.com/developers/api#access-tokens
FIGMA_TOKEN=figd_...

# Google API credentials
# Create a service account or OAuth2 credentials at https://console.cloud.google.com
# For simple export (public docs), leave blank — the pipeline uses the /export endpoint
GOOGLE_API_KEY=

# Output directory for generated files (relative to project root)
OUTPUT_DIR=./output

# Claude model to use
CLAUDE_MODEL=claude-sonnet-4-6
